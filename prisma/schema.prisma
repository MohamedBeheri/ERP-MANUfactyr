// This is your Prisma schema file
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============== ENUMS ==============
enum Role {
  ADMIN
  FACTORY
  WAREHOUSE
  SALES
  ACCOUNTANT
  DELEGATE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProductType {
  RAW // بن أخضر خام
  FINISHED // منتج نهائي
}

enum PaymentType {
  CASH // فوري
  CREDIT // آجل
}

enum CustomerType {
  RETAIL // قطاعي
  WHOLESALE // جملة
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  COMPLETED
  CANCELLED
  REFUNDED
}

enum OnlineOrderStatus {
  PENDING // طلب جديد
  CONFIRMED // اتأكد + اتخصم من المخزن
  PREPARING // بيتجهّز
  SHIPPED // خرج للتوصيل
  DELIVERED // اتسلّم
  CANCELLED // اتلغى
}

// ============== USERS & AUTH ==============
model User {
  id          String     @id @default(cuid())
  name        String
  username    String     @unique
  password    String // hashed with bcrypt
  // بيانات صاحب الحساب — عشان نربط الدخول بشخص
  phone       String?
  email       String?
  jobTitle    String? // المسمى الوظيفي (كاشير/مندوب/محاسب/مدير إنتاج...)
  nationalId  String? // الرقم القومي
  address     String?
  hireDate    DateTime? // تاريخ التعيين
  avatarUrl   String? // صورة شخصية (data URL أو رابط)
  notes       String?
  role        Role       @default(SALES)
  permissions String[]   @default([]) // مفاتيح صلاحيات: قسم أو قسم:فعل (view/add/edit/delete)
  status      UserStatus @default(ACTIVE)
  lastLogin   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  auditLogs                   AuditLog[]
  purchases                   Purchase[]
  productions                 Production[]
  warehouseIns                WarehouseIn[]
  warehouseOuts               WarehouseOut[]
  invoices                    Invoice[]
  deliveryOrders              DeliveryOrder[]
  settlements                 Settlement[]
  priceQuotes                 PriceQuote[]
  keyAccountSupplies          KeyAccountSupply[]
  keyAccountPayments          KeyAccountPayment[]
  deliveryReturns             DeliveryReturn[]
  supplierPayments            SupplierPayment[]
  delegateProfile             Delegate?              @relation("DelegateUser")
  treasurySettlementsCreated  TreasurySettlement[]   @relation("TreasurySettlementCreator")
  treasurySettlementsAccepted TreasurySettlement[]   @relation("TreasurySettlementAcceptor")
  liabilitiesCreated          Liability[]            @relation("LiabilityCreator")
  installmentsPaid            Installment[]          @relation("InstallmentPayer")
  treasuryNotifications       TreasuryNotification[] @relation("TreasuryNotifications")
  vouchersCreated             PaymentVoucher[]       @relation("VoucherCreator")
  vouchersApproved            PaymentVoucher[]       @relation("VoucherApprover")
  transfersCreated            StockTransfer[]        @relation("TransferCreator")
  transfersApproved           StockTransfer[]        @relation("TransferApprover")
  treasuryTxns                TreasuryTransaction[]  @relation("TreasuryTxnCreator")
  collectionsCreated          Collection[]           @relation("CollectionCreator")

  @@map("users")
}

// ============== CATEGORIES (التصنيفات) ==============
model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  products Product[]

  @@map("categories")
}

// ============== PRODUCTION STAGES (مراحل التصنيع - قديم) ==============
model ProductionStage {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("production_stages")
}

// ============== STOCK STAGES (التصنيف المخزني — قابل للتخصيص) ==============
// أمثلة: بن أخضر (خام) / بن محمّص / بن مطحون / منتج نهائي معبّأ
model StockStage {
  id          String   @id @default(cuid())
  name        String   @unique
  sortOrder   Int      @default(0)
  sellable    Boolean  @default(false) // يظهر في المبيعات ونقطة البيع
  purchasable Boolean  @default(false) // يدخل بأمر شراء (خامات)
  warehouseId String? // المخزن الافتراضي للمرحلة دي
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  warehouse Warehouse?            @relation(fields: [warehouseId], references: [id])
  products  Product[]
  opInputs  ProductionOperation[] @relation("OpInputStage")
  opOutputs ProductionOperation[] @relation("OpOutputStage")

  @@map("stock_stages")
}

// ============== PRODUCTION OPERATIONS (عمليات التصنيع — قابلة للتخصيص) ==============
// كل عملية بتحدد: بتسحب من أنهي مرحلة مخزنية وبتنتج في أنهي مرحلة
// مثال: "تحميص" تسحب من (بن أخضر) وتنتج في (بن محمّص) — "طحن وتعبئة" تسحب من (بن محمّص) وتنتج في (منتج نهائي)
model ProductionOperation {
  id              String   @id @default(cuid())
  name            String   @unique
  inputStageId    String?
  outputStageId   String?
  hasYieldLoss    Boolean  @default(true) // فيها هدر (زي التحميص)
  maxWastePercent Decimal  @default(0) @db.Decimal(5, 2) // حد الهدر الأقصى المسموح % (0 = بدون حد) — يحدده الأدمن
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  inputStage  StockStage?  @relation("OpInputStage", fields: [inputStageId], references: [id])
  outputStage StockStage?  @relation("OpOutputStage", fields: [outputStageId], references: [id])
  productions Production[]

  @@map("production_operations")
}

// ============== WAREHOUSES (المخازن) ==============
model Warehouse {
  id        String   @id @default(cuid())
  name      String   @unique
  location  String?
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  stocks         ProductStock[]
  ins            WarehouseIn[]
  outs           WarehouseOut[]
  stages         StockStage[]
  deliveryOrders DeliveryOrder[]
  transfersOut   StockTransfer[] @relation("TransferFrom")
  transfersIn    StockTransfer[] @relation("TransferTo")

  @@map("warehouses")
}

model ProductStock {
  id          String  @id @default(cuid())
  warehouseId String
  productId   String
  quantity    Decimal @default(0) @db.Decimal(12, 3)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@map("product_stocks")
}

// ============== PRODUCTS ==============
model Product {
  id             String      @id @default(cuid())
  name           String
  type           ProductType
  categoryId     String?
  stageId        String? // التصنيف المخزني (خام / محمّص / مطحون / نهائي)
  costPrice      Decimal     @db.Decimal(10, 2) // سعر التكلفة
  sellPrice      Decimal     @db.Decimal(10, 2) // سعر البيع قطاعي
  oldPrice       Decimal?    @db.Decimal(10, 2) // السعر قبل الخصم (لشارة التخفيض)
  wholesalePrice Decimal     @default(0) @db.Decimal(10, 2) // سعر البيع جملة
  minKeyPrice    Decimal     @default(0) @db.Decimal(10, 2) // أقل سعر مسموح لكبار الموردين (حد أدنى لبيان السعر)

  // ===== تصنيف الصنف في هيكل المصنع =====
  // GREEN (بن أخضر) | SPICE (عطارة/توابل) | FLAVOR (أساس نكهة) | BLEND (توليفة) | PACKAGING (مادة تغليف) | FINISHED (منتج نهائي)
  itemKind         String   @default("FINISHED")
  roastLossPercent Decimal  @default(0) @db.Decimal(5, 2) // نسبة خسران التحميص (للبن الأخضر)
  tareWeight       Decimal  @default(0) @db.Decimal(8, 3) // وزن الفارغ للقطعة بالجرام (لمواد التغليف)
  // مواصفات المنتج النهائي المعبّأ
  blendId          String? // التوليفة المستخدمة في التعبئة
  gramsPerPiece    Decimal  @default(0) @db.Decimal(8, 2) // وزن القطعة بالجرام
  piecesPerBox     Int      @default(1) // عدد القطع في العلبة/الوحدة
  packagingId      String? // مادة التغليف الأساسية
  minStock         Decimal  @default(0) @db.Decimal(12, 3) // الحد الأدنى
  quantity         Decimal  @default(0) @db.Decimal(12, 3) // الكمية الإجمالية (كل المخازن)
  unit             String   @default("كجم") // وحدة القياس
  imageUrl         String? // صورة المنتج (رابط أو data URL)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  category              Category?              @relation(fields: [categoryId], references: [id])
  stockStage            StockStage?            @relation(fields: [stageId], references: [id])
  stocks                ProductStock[]
  purchaseItems         PurchaseItem[]
  productionItems       ProductionItem[]
  productionInputs      ProductionInput[]      @relation("ProductionInputProduct")
  recipeItems           RecipeItem[]           @relation("RecipeItemProduct")
  productionsAsRaw      Production[]           @relation("ProductionRawProduct")
  invoiceItems          InvoiceItem[]
  deliveryItems         DeliveryItem[]
  warehouseIns          WarehouseIn[]
  warehouseOuts         WarehouseOut[]
  onlineOrderItems      OnlineOrderItem[]
  rewardRulesQualifying RewardRule[]           @relation("RewardQualifyingProduct")
  rewardRulesFree       RewardRule[]           @relation("RewardFreeProduct")
  priceQuoteItems       PriceQuoteItem[]
  keyAccountSupplyItems KeyAccountSupplyItem[]
  deliveryReturnItems   DeliveryReturnItem[]
  stockTransfers        StockTransfer[]

  // بنية المصنع: التوليفة والتغليف والمكوّنات
  blend                 Product?         @relation("ProductBlend", fields: [blendId], references: [id])
  finishedFromBlend     Product[]        @relation("ProductBlend")
  packaging             Product?         @relation("ProductPackaging", fields: [packagingId], references: [id])
  finishedFromPackaging Product[]        @relation("ProductPackaging")
  blendComponents       BlendComponent[] @relation("BlendParent") // مكوّنات هذه التوليفة
  usedInBlends          BlendComponent[] @relation("BlendComponent") // التوليفات اللي بتستخدم الصنف ده

  // الكافيه: توليفة استهلاك الخامات لكل وحدة مباعة (مشروب/ديزرت)
  cafeRecipeAsProduct  CafeRecipeItem[] @relation("CafeRecipeProduct")
  cafeRecipeAsMaterial CafeRecipeItem[] @relation("CafeRecipeMaterial")

  @@map("products")
}

// ============== الكافيه (تشغيل منفصل: خامات ديزرت/شوكولاتة/مشروبات + توليفات استهلاك) ==============
model CafeRecipeItem {
  id         String  @id @default(cuid())
  productId  String // الصنف المباع (مشروب/ديزرت) — itemKind = CAFE_ITEM
  materialId String // الخامة المستهلكة — itemKind = CAFE_MATERIAL
  quantity   Decimal @db.Decimal(10, 3) // الكمية المستهلكة من الخامة لكل وحدة مباعة

  product  Product @relation("CafeRecipeProduct", fields: [productId], references: [id], onDelete: Cascade)
  material Product @relation("CafeRecipeMaterial", fields: [materialId], references: [id])

  @@map("cafe_recipe_items")
}

// ============== BLEND COMPONENTS (مكوّنات التوليفة: بن أخضر بنسبة + عطارة بجرعة) ==============
model BlendComponent {
  id          String  @id @default(cuid())
  blendId     String // التوليفة (منتج itemKind=BLEND)
  componentId String // المكوّن (بن أخضر / عطارة / أساس نكهة)
  percent     Decimal @default(0) @db.Decimal(6, 3) // نسبة المكوّن في التوليفة (للبن الأخضر) — مجموع مكوّنات البن لازم = 100%
  roastDegree String? // درجة تحميص المكوّن (فاتح/وسط/غامق/غامق جداً) — زي "٧٠٪ إندونيسي فاتح"
  perKilo     Decimal @default(0) @db.Decimal(8, 3) // جرعة لكل كيلو توليفة (للعطارة/التوابل)

  blend     Product @relation("BlendParent", fields: [blendId], references: [id], onDelete: Cascade)
  component Product @relation("BlendComponent", fields: [componentId], references: [id])

  @@map("blend_components")
}

// ============== SUPPLIERS ==============
model Supplier {
  id             String   @id @default(cuid())
  name           String
  phone          String?
  address        String?
  email          String?
  totalPurchases Decimal  @default(0) @db.Decimal(12, 2)
  balance        Decimal  @default(0) @db.Decimal(12, 2) // المستحق للمورد (مطلوب دفعه)
  rating         Int      @default(5)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  // Relations
  purchases Purchase[]
  payments  SupplierPayment[]

  @@map("suppliers")
}

// ============== SUPPLIER PAYMENTS (تسديد للموردين) ==============
model SupplierPayment {
  id            String   @id @default(cuid())
  receiptNo     String?  @unique
  supplierId    String
  amount        Decimal  @db.Decimal(12, 2)
  method        String   @default("نقدي")
  balanceBefore Decimal  @default(0) @db.Decimal(12, 2)
  balanceAfter  Decimal  @default(0) @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime @default(now())
  createdById   String

  supplier Supplier @relation(fields: [supplierId], references: [id])
  creator  User     @relation(fields: [createdById], references: [id])

  @@map("supplier_payments")
}

// ============== PURCHASES (شراء بن أخضر) ==============
model Purchase {
  id                String      @id @default(cuid())
  invoiceNo         String      @unique // رقم أمر الشراء في النظام
  supplierInvoiceNo String? // رقم فاتورة المورد الورقية الفعلية
  invoiceImage      String? // صورة فاتورة المورد المرفقة (data URL)
  supplierId        String
  totalAmount       Decimal     @db.Decimal(12, 2)
  paymentMethod     String      @default("نقدي فوري") // نقدي فوري / آجل / نقدي جزئي
  paidAmount        Decimal     @default(0) @db.Decimal(12, 2) // المدفوع للمورد وقت الشراء
  notes             String?
  status            OrderStatus @default(COMPLETED)
  createdAt         DateTime    @default(now())
  createdById       String

  // Relations
  supplier Supplier       @relation(fields: [supplierId], references: [id])
  items    PurchaseItem[]
  creator  User           @relation(fields: [createdById], references: [id])

  @@map("purchases")
}

model PurchaseItem {
  id         String  @id @default(cuid())
  purchaseId String
  productId  String
  quantity   Decimal @db.Decimal(12, 3)
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)

  // Relations
  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@map("purchase_items")
}

// ============== PRODUCTION (التصنيع) ==============
model Production {
  id            String      @id @default(cuid())
  orderNo       String      @unique
  lineType      String      @default("ROASTING") // ROASTING (خط التحميص من البن الأخضر) / PROCESSING (خط الخلط والطحن والتعبئة)
  stage         String      @default("تحميص") // اسم المرحلة
  batchNo       String? // رقم التشغيلة/اللوط (Lot/Batch)
  roastLevel    String? // درجة التحميص: فاتح / وسط / غامق
  grindType     String? // درجة الطحن: ناعم جداً / ناعم / متوسط / خشن
  inputWeight   Decimal     @default(0) @db.Decimal(12, 3) // إجمالي وزن المدخلات (جرام)
  outputWeight  Decimal     @default(0) @db.Decimal(12, 3) // إجمالي وزن المخرجات (جرام)
  wasteWeight   Decimal     @default(0) @db.Decimal(12, 3) // الهدر (جرام)
  wastePercent  Decimal     @default(0) @db.Decimal(5, 2) // نسبة الهدر %
  wasteExceeded Boolean     @default(false) // الهدر عدّى الحد المسموح للعملية — تشغيلة متعلّمة + إشعار للأدمن
  expiryDate    DateTime? // تاريخ انتهاء الصلاحية للمنتج الناتج
  recipeId      String? // الوصفة المستخدمة (BOM)
  operationId   String? // عملية التصنيع المستخدمة
  channel       String      @default("المصنع") // جهة الإنتاج/الاستهلاك: المصنع / حلوان (الكافيه) / عبدالله (تحميص أجرة)
  // حقول قديمة للتوافق مع البيانات السابقة
  rawProductId  String?
  rawUsed       Decimal     @default(0) @db.Decimal(12, 3)
  opCost        Decimal     @default(0) @db.Decimal(10, 2) // تكلفة التشغيل
  notes         String?
  status        OrderStatus @default(COMPLETED)
  completedAt   DateTime? // وقت إقفال التشغيلة (لما العامل يرجع ويوزن الناتج)
  createdAt     DateTime    @default(now())
  createdById   String

  // Relations
  rawProduct Product?             @relation("ProductionRawProduct", fields: [rawProductId], references: [id])
  recipe     Recipe?              @relation(fields: [recipeId], references: [id])
  operation  ProductionOperation? @relation(fields: [operationId], references: [id])
  inputs     ProductionInput[]
  items      ProductionItem[]
  creator    User                 @relation(fields: [createdById], references: [id])

  @@map("productions")
}

// مدخلات أمر التصنيع (خامات متعددة — للخلطات BOM)
model ProductionInput {
  id           String  @id @default(cuid())
  productionId String
  productId    String
  quantity     Decimal @db.Decimal(12, 3) // الكمية المستخدمة (جرام)
  percentage   Decimal @default(0) @db.Decimal(5, 2) // النسبة في الخلطة %

  production Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  product    Product    @relation("ProductionInputProduct", fields: [productId], references: [id])

  @@map("production_inputs")
}

model ProductionItem {
  id           String  @id @default(cuid())
  productionId String
  productId    String
  quantity     Decimal @db.Decimal(12, 3) // الكمية المنتجة

  // Relations
  production Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@map("production_items")
}

// ============== RECIPES / BOM (الوصفات وقوائم المواد) ==============
model Recipe {
  id            String   @id @default(cuid())
  name          String   @unique
  lineType      String   @default("PROCESSING") // الخط اللي بتنتمي له الوصفة
  outputName    String? // اسم المنتج النهائي المتوقع
  roastLevel    String?
  grindType     String?
  expectedWaste Decimal  @default(0) @db.Decimal(5, 2) // نسبة الهدر المتوقعة %
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  items       RecipeItem[]
  productions Production[]

  @@map("recipes")
}

model RecipeItem {
  id         String  @id @default(cuid())
  recipeId   String
  productId  String
  percentage Decimal @db.Decimal(5, 2) // نسبة الخامة في الوصفة %

  recipe  Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product Product @relation("RecipeItemProduct", fields: [productId], references: [id])

  @@map("recipe_items")
}

// ============== WAREHOUSE (المخزن) ==============
model WarehouseIn {
  id          String   @id @default(cuid())
  productId   String
  warehouseId String?
  quantity    Decimal  @db.Decimal(12, 3)
  source      String // المصدر (مثال: "المصنع - أمر تصنيع #1")
  notes       String?
  createdAt   DateTime @default(now())
  createdById String

  // Relations
  product   Product    @relation(fields: [productId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])
  creator   User       @relation(fields: [createdById], references: [id])

  @@map("warehouse_ins")
}

model WarehouseOut {
  id          String   @id @default(cuid())
  productId   String
  warehouseId String?
  quantity    Decimal  @db.Decimal(12, 3)
  target      String // الجهة (مثال: "مندوب: أحمد" أو "فرع رئيسي")
  reason      String // السبب (فاتورة بيع، أمر تسليم، مرتجعات)
  notes       String?
  createdAt   DateTime @default(now())
  createdById String

  // Relations
  product   Product    @relation(fields: [productId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])
  creator   User       @relation(fields: [createdById], references: [id])

  @@map("warehouse_outs")
}

// ============== STOCK TRANSFERS (تحويلات بين المخازن) ==============
model StockTransfer {
  id              String         @id @default(cuid())
  transferNo      String         @unique @default(cuid())
  fromWarehouseId String
  toWarehouseId   String
  productId       String
  quantity        Decimal        @db.Decimal(12, 3)
  reason          String // سبب التحويل
  notes           String?
  status          TransferStatus @default(PENDING)
  createdAt       DateTime       @default(now())
  executedAt      DateTime?
  createdById     String
  approvedById    String?

  fromWarehouse Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])
  product       Product   @relation(fields: [productId], references: [id])
  creator       User      @relation("TransferCreator", fields: [createdById], references: [id])
  approvedBy    User?     @relation("TransferApprover", fields: [approvedById], references: [id])

  @@map("stock_transfers")
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
}

// ============== CUSTOMER TIERS (فئات العملاء والبونص) ==============
// كبار الموردين/الموزعين، كبار العملاء، تاجر تجزئة، متوسط، قطاعي — لكل فئة تسعير وبونص خاص
model CustomerTier {
  id              String   @id @default(cuid())
  name            String   @unique
  priceSource     String   @default("RETAIL") // RETAIL (سعر قطاعي) | WHOLESALE (سعر جملة)
  discountPercent Decimal  @default(0) @db.Decimal(5, 2) // خصم إضافي على السعر الأساسي %
  bonusPercent    Decimal  @default(0) @db.Decimal(5, 2) // بونص يُكسب كنسبة من قيمة المشتريات %
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  customers   Customer[]
  rewardRules RewardRule[]

  @@map("customer_tiers")
}

// ============== REWARD RULES (مكافآت الكمية — اشترِ X خُد Y هدية) ==============
model RewardRule {
  id            String   @id @default(cuid())
  name          String // اسم العرض (مثلا: عرض أكياس 10 جم)
  productId     String // الصنف المؤهِّل (اللي بيشتريه العميل)
  buyQuantity   Int // الكمية المطلوبة بالوحدة الأساسية (مثلا 180 كيس = 3 شرينك)
  bundleSize    Int      @default(1) // حجم العبوة/الشرينك للعرض فقط (60)
  freeProductId String // الصنف الهدية (غالبًا نفس المنتج)
  freeQuantity  Int // عدد الهدية لكل مرة تأهيل (مثلا 18)
  repeat        Boolean  @default(true) // يتكرر مع مضاعفات الكمية
  tierId        String? // فئة العميل المستهدفة (null = كل الفئات)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  product      Product       @relation("RewardQualifyingProduct", fields: [productId], references: [id])
  freeProduct  Product       @relation("RewardFreeProduct", fields: [freeProductId], references: [id])
  tier         CustomerTier? @relation(fields: [tierId], references: [id])
  invoiceItems InvoiceItem[]

  @@map("reward_rules")
}

// ============== CUSTOMERS (العملاء) ==============
model Customer {
  id             String       @id @default(cuid())
  name           String
  phone          String?
  address        String?
  area           String? // منطقة/خط سير العميل (لفلترة عملاء المندوب)
  activityType   String? // نوع النشاط (كافيه / سوبر ماركت / بقالة / مطعم...)
  type           PaymentType  @default(CASH)
  customerType   CustomerType @default(RETAIL) // جملة أو قطاعي
  tierId         String? // فئة العميل (كبار عملاء / تجزئة / متوسط...)
  bonusPoints    Decimal      @default(0) @db.Decimal(12, 2) // رصيد البونص (1 نقطة = 1 ج.م)
  creditLimit    Decimal      @default(0) @db.Decimal(12, 2) // الحد الائتماني
  balance        Decimal      @default(0) @db.Decimal(12, 2) // الرصيد المدين
  totalPurchases Decimal      @default(0) @db.Decimal(12, 2)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  // Relations
  tier            CustomerTier?    @relation(fields: [tierId], references: [id])
  invoices        Invoice[]
  onlineOrders    OnlineOrder[]
  deliveryReturns DeliveryReturn[]
  collections     Collection[]

  @@map("customers")
}

// ============== KEY ACCOUNTS (كبار الموردين / بيوت الجملة) ==============
// عميل له مقر رئيسي إداري وفروع بيع متعددة، وتعامل تجاري ببيانات سعر وعقود ومطالبات.
model KeyAccount {
  id             String   @id @default(cuid())
  name           String // اسم العميل
  brandName      String? // اسم الماركة التجارية
  activityType   String? // نوع النشاط
  phone          String?
  address        String? // عنوان المقر الرئيسي
  balance        Decimal  @default(0) @db.Decimal(12, 2) // المطالبات المجمّعة على المقر الرئيسي
  totalPurchases Decimal  @default(0) @db.Decimal(12, 2)
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  branches KeyAccountBranch[]
  quotes   PriceQuote[]
  supplies KeyAccountSupply[]
  payments KeyAccountPayment[]

  @@map("key_accounts")
}

model KeyAccountBranch {
  id           String   @id @default(cuid())
  keyAccountId String
  name         String // اسم الفرع (مثلا: فرع المنوفية)
  address      String?
  phone        String?
  manager      String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  keyAccount KeyAccount         @relation(fields: [keyAccountId], references: [id], onDelete: Cascade)
  supplies   KeyAccountSupply[]

  @@map("key_account_branches")
}

// ============== PRICE QUOTES (بيان سعر / عرض سعر توريد) ==============
model PriceQuote {
  id              String    @id @default(cuid())
  quoteNo         String    @unique
  keyAccountId    String
  status          String    @default("DRAFT") // DRAFT | APPROVED | CANCELLED
  discountType    String    @default("NONE") // NONE | CASH (خصم نقدي فعلي مش بونص)
  discountPercent Decimal   @default(0) @db.Decimal(5, 2)
  adminExpenses   Decimal   @default(0) @db.Decimal(12, 2) // مصاريف إدارية تُحمّل على البيان
  notes           String?
  validUntil      DateTime?
  createdAt       DateTime  @default(now())
  createdById     String

  keyAccount KeyAccount       @relation(fields: [keyAccountId], references: [id], onDelete: Cascade)
  creator    User             @relation(fields: [createdById], references: [id])
  items      PriceQuoteItem[]

  @@map("price_quotes")
}

model PriceQuoteItem {
  id        String  @id @default(cuid())
  quoteId   String
  productId String
  quantity  Decimal @default(0) @db.Decimal(12, 3) // اختياري (0 = بيان أسعار بدون كميات)
  unitPrice Decimal @db.Decimal(10, 2) // السعر اليدوي (لا يقل عن minKeyPrice)

  quote   PriceQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id])

  @@map("price_quote_items")
}

// ============== KEY ACCOUNT SUPPLIES (توريد لفروع كبار الموردين أثناء جولة المندوب) ==============
model KeyAccountSupply {
  id              String   @id @default(cuid())
  supplyNo        String   @unique
  keyAccountId    String
  branchId        String
  deliveryOrderId String? // الجولة اللي اتعمل منها التوريد
  delegateId      String?
  totalAmount     Decimal  @db.Decimal(12, 2)
  discountType    String   @default("NONE") // NONE | CASH
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  netAmount       Decimal  @db.Decimal(12, 2) // يُضاف كمطالبة على المقر الرئيسي
  notes           String?
  createdAt       DateTime @default(now())
  createdById     String

  keyAccount    KeyAccount             @relation(fields: [keyAccountId], references: [id])
  branch        KeyAccountBranch       @relation(fields: [branchId], references: [id])
  deliveryOrder DeliveryOrder?         @relation(fields: [deliveryOrderId], references: [id])
  delegate      Delegate?              @relation(fields: [delegateId], references: [id])
  creator       User                   @relation(fields: [createdById], references: [id])
  items         KeyAccountSupplyItem[]

  @@map("key_account_supplies")
}

model KeyAccountSupplyItem {
  id         String  @id @default(cuid())
  supplyId   String
  productId  String
  quantity   Decimal @db.Decimal(12, 3)
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)

  supply  KeyAccountSupply @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  product Product          @relation(fields: [productId], references: [id])

  @@map("key_account_supply_items")
}

// ============== KEY ACCOUNT PAYMENTS (تحصيل من المقر الرئيسي) ==============
model KeyAccountPayment {
  id            String   @id @default(cuid())
  receiptNo     String?  @unique
  keyAccountId  String
  amount        Decimal  @db.Decimal(12, 2)
  method        String   @default("نقدي")
  balanceBefore Decimal  @default(0) @db.Decimal(12, 2)
  balanceAfter  Decimal  @default(0) @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime @default(now())
  createdById   String

  keyAccount KeyAccount @relation(fields: [keyAccountId], references: [id])
  creator    User       @relation(fields: [createdById], references: [id])

  @@map("key_account_payments")
}

// ============== SALES POINTS (نقاط البيع) ==============
model SalesPoint {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  manager   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Relations
  invoices Invoice[]

  @@map("sales_points")
}

// ============== INVOICES (فواتير البيع) ==============
model Invoice {
  id               String        @id @default(cuid())
  invoiceNo        String        @unique
  customerId       String
  totalAmount      Decimal       @db.Decimal(12, 2)
  discount         Decimal       @default(0) @db.Decimal(5, 2) // نسبة الخصم
  netAmount        Decimal       @db.Decimal(12, 2)
  paidAmount       Decimal       @default(0) @db.Decimal(12, 2) // المبلغ المدفوع فعليًا (للدفع الجزئي)
  type             PaymentType
  paymentMethod    String        @default("نقدي") // نقدي فوري / آجل / نقدي جزئي
  collectionMethod String? // طريقة استلام المبلغ: نقدي / تحويل محفظة / تحويل انستا (للفوري والجزئي)
  invoiceNotes     String? // ملاحظات المندوب على الفاتورة
  pointId          String?
  delegateId       String? // لو الفاتورة اتعملت أثناء جولة توزيع مندوب
  deliveryOrderId  String? // الجولة المرتبطة
  status           InvoiceStatus @default(COMPLETED)
  createdAt        DateTime      @default(now())
  createdById      String

  // Relations
  customer        Customer         @relation(fields: [customerId], references: [id])
  point           SalesPoint?      @relation(fields: [pointId], references: [id])
  delegate        Delegate?        @relation(fields: [delegateId], references: [id])
  deliveryOrder   DeliveryOrder?   @relation(fields: [deliveryOrderId], references: [id])
  items           InvoiceItem[]
  creator         User             @relation(fields: [createdById], references: [id])
  deliveryReturns DeliveryReturn[]

  @@map("invoices")
}

model InvoiceItem {
  id           String  @id @default(cuid())
  invoiceId    String
  productId    String
  quantity     Decimal @db.Decimal(12, 3)
  unitPrice    Decimal @db.Decimal(10, 2)
  totalPrice   Decimal @db.Decimal(10, 2)
  isBonus      Boolean @default(false) // بند هدية/بونص كمية (سعره صفر)
  rewardRuleId String? // العرض اللي منح الهدية دي

  // Relations
  invoice     Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product              @relation(fields: [productId], references: [id])
  rewardRule  RewardRule?          @relation(fields: [rewardRuleId], references: [id])
  returnItems DeliveryReturnItem[]

  @@map("invoice_items")
}

// ============== VEHICLES (عربيات التوزيع) ==============
model Vehicle {
  id        String   @id @default(cuid())
  plateNo   String   @unique // أرقام وحروف اللوحة (مثلا: س م ص ٢٢١٢)
  model     String? // موديل/نوع العربية
  capacity  Int      @default(0) // السعة التقريبية (وحدة)
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  delegates Delegate[]

  @@map("vehicles")
}

// ============== DELEGATES (المندوبين — موظفي التوزيع) ==============
model Delegate {
  id             String   @id @default(cuid())
  name           String
  phone          String?
  userId         String?  @unique // حساب دخول المندوب على السستم (لصفحته الشخصية)
  vehicleId      String? // العربية المسندة إليه
  carNumber      String? // (قديم — بيتعوّض بالعربية المرتبطة)
  area           String? // المنطقة
  route          String? // خط السير
  commissionRate Decimal  @default(5) @db.Decimal(5, 2) // نسبة العمولة
  totalSales     Decimal  @default(0) @db.Decimal(12, 2)
  commissionDue  Decimal  @default(0) @db.Decimal(12, 2)
  commissionPaid Decimal  @default(0) @db.Decimal(12, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  // Relations
  user                User?                @relation("DelegateUser", fields: [userId], references: [id])
  vehicle             Vehicle?             @relation(fields: [vehicleId], references: [id])
  deliveryOrders      DeliveryOrder[]
  settlements         Settlement[]
  invoices            Invoice[]
  keyAccountSupplies  KeyAccountSupply[]
  treasurySettlements TreasurySettlement[] @relation("TreasurySettlements")
  cashTreasury        Treasury?
  collections         Collection[]         @relation("DelegateCollections")

  @@map("delegates")
}

// ============== DELIVERY ORDERS (أوامر التسليم) ==============
model DeliveryOrder {
  id          String      @id @default(cuid())
  orderNo     String      @unique
  delegateId  String
  warehouseId String? // المخزن اللي هيتحمّل منه (يحدده مدير المبيعات)
  status      OrderStatus @default(PENDING) // PENDING = مستني تأكيد استلام المندوب · IN_PROGRESS = اتسلّم وبيوزّع · COMPLETED = اتسوّى
  receivedAt  DateTime? // وقت تأكيد المندوب استلام الحمولة (مطابقة الاستلام)
  notes       String?
  createdAt   DateTime    @default(now())
  createdById String

  // Relations
  delegate           Delegate            @relation(fields: [delegateId], references: [id])
  warehouse          Warehouse?          @relation(fields: [warehouseId], references: [id])
  items              DeliveryItem[]
  invoices           Invoice[]
  settlement         Settlement?
  treasurySettlement TreasurySettlement? @relation("TreasurySettlementOrder")
  keyAccountSupplies KeyAccountSupply[]
  returns            DeliveryReturn[]
  creator            User                @relation(fields: [createdById], references: [id])

  @@map("delivery_orders")
}

// ============== DELIVERY RETURNS (مرتجع من عميل أثناء الجولة — البضاعة ترجع للعربية) ==============
model DeliveryReturn {
  id              String   @id @default(cuid())
  returnNo        String   @unique
  deliveryOrderId String
  invoiceId       String? // الفاتورة الأصلية اللي بيترجع منها
  customerId      String?
  customerName    String? // لو المرتجع من عميل غير مسجّل
  refundCash      Boolean  @default(false) // true = رد نقدي، false = خصم من رصيد العميل الآجل
  pointsReversed  Decimal  @default(0) @db.Decimal(12, 2) // بونص النقاط اللي اترجع بسبب المرتجع
  totalValue      Decimal  @db.Decimal(12, 2)
  reason          String?
  notes           String?
  createdAt       DateTime @default(now())
  createdById     String

  deliveryOrder DeliveryOrder        @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  invoice       Invoice?             @relation(fields: [invoiceId], references: [id])
  customer      Customer?            @relation(fields: [customerId], references: [id])
  creator       User                 @relation(fields: [createdById], references: [id])
  items         DeliveryReturnItem[]

  @@map("delivery_returns")
}

model DeliveryReturnItem {
  id            String  @id @default(cuid())
  returnId      String
  productId     String
  invoiceItemId String? // بند الفاتورة الأصلي (يفرّق بين البند المدفوع والهدية لنفس الصنف)
  isBonus       Boolean @default(false) // بند هدية اترجع
  quantity      Decimal @db.Decimal(12, 3)
  unitPrice     Decimal @db.Decimal(10, 2)
  totalPrice    Decimal @db.Decimal(10, 2)

  deliveryReturn DeliveryReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id])
  invoiceItem    InvoiceItem?   @relation(fields: [invoiceItemId], references: [id])

  @@map("delivery_return_items")
}

model DeliveryItem {
  id              String  @id @default(cuid())
  deliveryOrderId String
  productId       String
  quantity        Decimal @db.Decimal(12, 3)

  // Relations
  deliveryOrder DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@map("delivery_items")
}

// ============== SETTLEMENTS (تسويات المندوبين) ==============
model Settlement {
  id              String   @id @default(cuid())
  delegateId      String
  deliveryOrderId String?  @unique // الجولة اللي التسوية دي بتاعتها
  soldQty         Decimal  @default(0) @db.Decimal(12, 3) // المباع (بدون الهدايا)
  bonusQty        Decimal  @default(0) @db.Decimal(12, 3) // إجمالي الهدايا/البونص اللي اتوزّعت في الجولة
  returnedQty     Decimal  @default(0) @db.Decimal(12, 3) // المرتجع
  cashAmount      Decimal  @default(0) @db.Decimal(12, 2) // النقدية
  creditAmount    Decimal  @default(0) @db.Decimal(12, 2) // الآجل
  commission      Decimal  @default(0) @db.Decimal(12, 2) // العمولة
  notes           String?
  createdAt       DateTime @default(now())
  createdById     String

  // Relations
  delegate      Delegate       @relation(fields: [delegateId], references: [id])
  deliveryOrder DeliveryOrder? @relation(fields: [deliveryOrderId], references: [id])
  creator       User           @relation(fields: [createdById], references: [id])

  @@map("settlements")
}

// ============== CASH FLOW (التدفق النقدي) ==============
model CashFlow {
  id          String           @id @default(cuid())
  description String
  type        String // "IN" or "OUT"
  amount      Decimal          @db.Decimal(12, 2)
  balance     Decimal          @db.Decimal(12, 2)
  reference   String? // رقم الفاتورة/الأمر
  activity    CashFlowActivity @default(OPERATING) // نوع النشاط في قائمة التدفقات
  voucherId   String? // سند الصرف المرتبط
  createdAt   DateTime         @default(now())

  voucher PaymentVoucher? @relation(fields: [voucherId], references: [id])

  @@map("cash_flow")
}

// ============== AUDIT LOG (سجل المراجعة) ==============
model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  action      String // نوع العملية
  description String // الوصف
  impact      String // التأثير
  ipAddress   String?
  createdAt   DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// ============== TREASURY SETTLEMENTS (تسويات الخزنة) ==============
enum TreasurySettlementStatus {
  PENDING // مقدّمة من المندوب — في انتظار قبول أمين الخزنة
  ACCEPTED // اعتمدها أمين الخزنة — حُدّث رصيد الخزنة
  REJECTED // رفضها أمين الخزنة مع سبب الرفض
}

model TreasurySettlement {
  id              String                   @id @default(cuid())
  settlementNo    String                   @unique // TRS-YYYYMMDD-001
  delegateId      String
  deliveryOrderId String?                  @unique // الجولة اللي التسوية دي ناتجة عنها
  amount          Decimal                  @db.Decimal(12, 2) // المبلغ المسلّم
  method          String                   @default("CASH") // CASH | CHECK | TRANSFER
  checkNo         String? // رقم الشيك (لو الدفع بشيك)
  bankName        String? // البنك (لو شيك أو تحويل)
  notes           String?
  status          TreasurySettlementStatus @default(PENDING)
  rejectionReason String? // سبب الرفض (لو REJECTED)
  createdById     String // المندوب اللي قدّم التسوية
  acceptedById    String? // أمين الخزنة اللي قبل
  acceptedAt      DateTime?
  createdAt       DateTime                 @default(now())

  delegate      Delegate       @relation("TreasurySettlements", fields: [delegateId], references: [id])
  deliveryOrder DeliveryOrder? @relation("TreasurySettlementOrder", fields: [deliveryOrderId], references: [id])
  createdBy     User           @relation("TreasurySettlementCreator", fields: [createdById], references: [id])
  acceptedBy    User?          @relation("TreasurySettlementAcceptor", fields: [acceptedById], references: [id])

  @@map("treasury_settlements")
}

// ============== LIABILITIES (الالتزامات المالية) ==============
enum LiabilityType {
  LOAN // قرض بنكي
  CHECK // شيك مستحق
  INSTALLMENT_PLAN // تقسيط
  FINANCING_COMPANY // شركة تمويل (أمان/تسهيل)
  REAL_ESTATE // عقارات (فيلا/شقة)
  INSURANCE // وثيقة تأمين على الحياة
  OTHER
}

enum CashFlowActivity {
  OPERATING // أنشطة تشغيلية — تدخل قائمة الدخل
  INVESTING // أنشطة استثمارية — أصول عقارية وتأمين (لا تدخل P&L)
  FINANCING // أنشطة تمويلية — قروض وتسهيلات (لا تدخل P&L)
}

enum PaymentVoucherStatus {
  DRAFT
  APPROVED
  CANCELLED
}

enum LiabilityStatus {
  ACTIVE // جارية
  SETTLED // مسدّدة بالكامل
  OVERDUE // متأخرة
  CANCELLED
}

enum InstallmentStatus {
  UNPAID
  PAID
  OVERDUE
  PARTIALLY_PAID
}

model Liability {
  id              String          @id @default(cuid())
  liabilityNo     String          @unique // LIB-YYYYMMDD-001
  type            LiabilityType
  creditor        String // الجهة الدائنة (بنك / مورد / شخص)
  totalAmount     Decimal         @db.Decimal(12, 2) // إجمالي المبلغ
  paidAmount      Decimal         @default(0) @db.Decimal(12, 2) // المسدّد
  remainingAmount Decimal         @db.Decimal(12, 2) // المتبقي (يتحدّث تلقائي)
  interestRate    Decimal         @default(0) @db.Decimal(5, 2) // نسبة الفائدة %
  startDate       DateTime // تاريخ بداية الالتزام
  dueDate         DateTime? // تاريخ السداد النهائي
  status          LiabilityStatus @default(ACTIVE)
  notes           String?
  createdById     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  createdBy       User             @relation("LiabilityCreator", fields: [createdById], references: [id])
  installments    Installment[]
  paymentVouchers PaymentVoucher[]

  @@map("liabilities")
}

model Installment {
  id            String            @id @default(cuid())
  liabilityId   String
  installmentNo Int // رقم القسط (1, 2, 3...)
  amount        Decimal           @db.Decimal(12, 2) // المبلغ المطلوب
  paidAmount    Decimal           @default(0) @db.Decimal(12, 2) // المدفوع فعلياً
  dueDate       DateTime // تاريخ الاستحقاق
  paidDate      DateTime? // تاريخ السداد الفعلي
  status        InstallmentStatus @default(UNPAID)
  notes         String?
  paidById      String? // الشخص اللي سدّد

  liability       Liability        @relation(fields: [liabilityId], references: [id], onDelete: Cascade)
  paidBy          User?            @relation("InstallmentPayer", fields: [paidById], references: [id])
  paymentVouchers PaymentVoucher[]

  @@unique([liabilityId, installmentNo])
  @@map("installments")
}

// ============== PAYMENT VOUCHERS (سندات الصرف) ==============
model PaymentVoucher {
  id            String               @id @default(cuid())
  voucherNo     String               @unique // PV-YYYYMMDD-001
  description   String // وصف السند
  amount        Decimal              @db.Decimal(12, 2)
  categoryId    String? // بند المصروف
  activity      CashFlowActivity // نوع النشاط (تشغيلي/استثماري/تمويلي)
  status        PaymentVoucherStatus @default(DRAFT)
  liabilityId   String? // الالتزام المرتبط (لو سداد قسط/قرض)
  installmentId String? // القسط المرتبط
  paymentMethod String               @default("CASH") // CASH | CHECK | TRANSFER
  treasuryId    String? // الخزنة اللي اتصرف منها المبلغ
  checkNo       String?
  bankName      String?
  notes         String?
  createdById   String
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime             @default(now())

  treasury    Treasury?        @relation(fields: [treasuryId], references: [id])
  category    ExpenseCategory? @relation(fields: [categoryId], references: [id])
  liability   Liability?       @relation(fields: [liabilityId], references: [id])
  installment Installment?     @relation(fields: [installmentId], references: [id])
  createdBy   User             @relation("VoucherCreator", fields: [createdById], references: [id])
  approvedBy  User?            @relation("VoucherApprover", fields: [approvedById], references: [id])
  cashFlows   CashFlow[]

  @@map("payment_vouchers")
}

// ============== TREASURIES & COLLECTIONS (الخزائن وسندات التحصيل) ==============
enum TreasuryType {
  SALESMAN_CASH // خزنة مندوب نقدية
  MAIN_CASH // الخزنة العمومية
  CLEARING_ACCOUNT // حساب وسيط تحت التسوية (إنستا باي)
  BANK // حساب بنكي
}

enum PaymentMethodType {
  CASH // نقدي
  ELECTRONIC // إلكتروني (إنستا باي / محفظة)
  BANK // شبكة / تحويل بنكي
}

model PaymentMethod {
  id        String            @id @default(cuid())
  name      String            @unique // نقدي / إنستا باي / شبكة
  type      PaymentMethodType
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())

  collections Collection[]

  @@map("payment_methods")
}

model Treasury {
  id                       String       @id @default(cuid())
  name                     String       @unique
  type                     TreasuryType
  balance                  Decimal      @default(0) @db.Decimal(14, 2)
  allowExpenseDisbursement Boolean      @default(false) // مسموح الصرف منها؟
  delegateId               String?      @unique // خزنة مندوب — مربوطة بمندوب واحد
  isActive                 Boolean      @default(true)
  createdAt                DateTime     @default(now())

  delegate     Delegate?             @relation(fields: [delegateId], references: [id])
  transactions TreasuryTransaction[]
  collections  Collection[]
  vouchers     PaymentVoucher[]

  @@map("treasuries")
}

// دفتر أستاذ الخزنة — كل حركة برصيدها بعد التنفيذ (كشف حساب)
model TreasuryTransaction {
  id          String   @id @default(cuid())
  treasuryId  String
  type        String // IN | OUT
  amount      Decimal  @db.Decimal(14, 2)
  balance     Decimal  @db.Decimal(14, 2) // الرصيد بعد الحركة
  refType     String // collection | transfer | expense | settlement | instapay-settle
  reference   String? // رقم السند / رقم العملية
  description String
  createdById String
  createdAt   DateTime @default(now())

  treasury  Treasury @relation(fields: [treasuryId], references: [id])
  createdBy User     @relation("TreasuryTxnCreator", fields: [createdById], references: [id])

  @@map("treasury_transactions")
}

// سند تحصيل من عميل — التوجيه للخزنة حسب نوع وسيلة الدفع
model Collection {
  id                   String    @id @default(cuid())
  collectionNo         String    @unique // COL-YYYYMMDD-001
  customerId           String
  delegateId           String?
  amount               Decimal   @db.Decimal(12, 2)
  paymentMethodId      String
  transactionReference String? // إجباري لو إلكتروني
  treasuryId           String // الخزنة اللي راح لها المبلغ
  isSettled            Boolean   @default(false) // اتسوّت للبنك؟ (للإلكتروني)
  settledAt            DateTime?
  notes                String?
  createdById          String
  createdAt            DateTime  @default(now())

  customer      Customer      @relation(fields: [customerId], references: [id])
  delegate      Delegate?     @relation("DelegateCollections", fields: [delegateId], references: [id])
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  treasury      Treasury      @relation(fields: [treasuryId], references: [id])
  createdBy     User          @relation("CollectionCreator", fields: [createdById], references: [id])

  @@map("collections")
}

// ============== EXPENSE CATEGORIES (بنود المصروفات) ==============
model ExpenseCategory {
  id        String           @id @default(cuid())
  name      String // اسم البند (رواتب / إيجار / صيانة ...)
  code      String?          @unique // كود اختصاري اختياري
  activity  CashFlowActivity @default(OPERATING) // تصنيف النشاط
  affectsPL Boolean          @default(true) // يدخل قائمة الأرباح والخسائر؟
  parentId  String? // بند أب (مجموعة)
  isActive  Boolean          @default(true)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())

  parent   ExpenseCategory?  @relation("SubCategories", fields: [parentId], references: [id])
  children ExpenseCategory[] @relation("SubCategories")
  vouchers PaymentVoucher[]

  @@map("expense_categories")
}

// ============== TREASURY NOTIFICATIONS (إشعارات الخزنة) ==============
model TreasuryNotification {
  id        String   @id @default(cuid())
  type      String // INSTALLMENT_DUE | INSTALLMENT_OVERDUE | SETTLEMENT_PENDING | LIABILITY_OVERDUE
  title     String
  message   String
  refId     String? // معرّف الكيان المرتبط (liability / installment / settlement)
  isRead    Boolean  @default(false)
  userId    String? // المستخدم المستهدف بالإشعار (null = الكل)
  createdAt DateTime @default(now())

  user User? @relation("TreasuryNotifications", fields: [userId], references: [id])

  @@map("treasury_notifications")
}

// ============== ONLINE STORE (متجر العميل أونلاين) ==============
model StoreSettings {
  id             String   @id @default("store")
  storeName      String   @default("شركة البدر لتجارة البن")
  tagline        String   @default("قهوة طازجة تتحمّص وتُطحن حسب طلبك")
  heroImage      String?
  phone          String?
  whatsapp       String?
  address        String?
  deliveryFee    Decimal  @default(0) @db.Decimal(10, 2)
  minOrder       Decimal  @default(0) @db.Decimal(10, 2)
  warehouseId    String? // المخزن اللي بيتباع منه أونلاين
  isOpen         Boolean  @default(true) // المتجر شغّال ولا لأ
  showOutOfStock Boolean  @default(true)
  codEnabled     Boolean  @default(true) // الدفع عند الاستلام
  accentColor    String   @default("#e9b44c") // لون الموقع الأساسي
  bgTheme        String   @default("dark") // dark | light
  fontFamily     String   @default("Cairo") // خط الموقع
  heroInterval   Int      @default(6) // زمن تحرك السلايدر بالثواني
  heroMotion     String   @default("slide") // slide | fade — حركة الانتقال
  cardEnabled    Boolean  @default(false) // الدفع بالفيزا
  promoText      String? // شريط العرض الترويجي
  promoLink      String?
  aboutTitle     String? // عنوان قصة العلامة
  aboutText      String? // نص قصة العلامة
  facebook       String?
  instagram      String?
  email          String?
  updatedAt      DateTime @updatedAt

  @@map("store_settings")
}

model OnlineOrder {
  id            String            @id @default(cuid())
  orderNo       String            @unique
  customerId    String?
  customerName  String
  phone         String
  address       String
  notes         String?
  subtotal      Decimal           @db.Decimal(12, 2)
  deliveryFee   Decimal           @default(0) @db.Decimal(10, 2)
  total         Decimal           @db.Decimal(12, 2)
  paymentMethod String            @default("الدفع عند الاستلام")
  status        OnlineOrderStatus @default(PENDING)
  warehouseId   String?
  invoiceId     String?
  createdAt     DateTime          @default(now())

  customer Customer?         @relation(fields: [customerId], references: [id])
  items    OnlineOrderItem[]

  @@map("online_orders")
}

model OnlineOrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  productName String
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(10, 2)
  totalPrice  Decimal @db.Decimal(10, 2)

  order   OnlineOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id])

  @@map("online_order_items")
}

model HeroSlide {
  id        String   @id @default(cuid())
  type      String   @default("IMAGE") // IMAGE | VIDEO
  media     String // رابط أو data URL
  badge     String?
  title1    String?
  title2    String?
  subtitle  String?
  ctaText   String?
  ctaLink   String?  @default("/store")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("hero_slides")
}

// بلوكات محتوى الموقع — كلها dynamic من الداشبورد
// ROAST_CARD (كروت التحميص) | BRAND_CARD (خطوط المنتجات) | LOYALTY_STEP (خطوات الولاء) | REVIEW (آراء العملاء)
model StoreBlock {
  id        String   @id @default(cuid())
  kind      String // ROAST_CARD | BRAND_CARD | LOYALTY_STEP | REVIEW
  title     String
  subtitle  String?
  imageUrl  String?
  link      String? // رابط أو categoryId للكروت القابلة للضغط
  rating    Int      @default(5) // للتقييمات
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("store_blocks")
}
